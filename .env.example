# --- Server ---
# Used only when running the Node API (npm --workspace server run start / docker).
PORT=4000
NODE_ENV=production
# A long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string
# Set to 1 when served over HTTPS (Netlify, Render, tunnels).
COOKIE_SECURE=1

# --- Database (Turso / libSQL) ---
# Leave both blank to use a local SQLite file at data/mandi.sqlite (development).
# Set them to run against a free Turso database (persistent, works on stateless hosts).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Web (frontend build) ---
# Optional. Leave blank when the frontend proxies /api (Netlify netlify.toml).
# Set to your API origin (e.g. https://shivmandi-api.onrender.com) to call it directly.
VITE_API_BASE=
